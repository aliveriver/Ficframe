    "_meta": {
      "title": "FicFrame Image Size"
    }
  },
  "6": {
    "inputs": {
      "text": "{{prompt}}",
      "clip": [
        "4",
        1
      ]
    },
    "class_type": "CLIPTextEncode",
    "_meta": {
      "title": "FicFrame Prompt"
    }
  },
  "7": {
    "inputs": {
      "text": "{{negative_prompt}}",
      "clip": [
        "4",
        1
      ]
    },
    "class_type": "CLIPTextEncode",
    "_meta": {
      "title": "FicFrame Negative Prompt"
    }
  },
  "8": {
    "inputs": {
      "samples": [
        "3",
        0
      ],
      "vae": [
        "4",
        2
      ]
    },
    "class_type": "VAEDecode",
    "_meta": {
      "title": "Decode Image"
    }
  },
  "9": {
    "inputs": {
      "filename_prefix": "FicFrame",
      "images": [
        "8",
        0
      ]
    },
    "class_type": "SaveImage",
    "_meta": {
      "title": "FicFrame Output"
    }
