        0
      ],
      "negative": [
        "7",
        0
      ],
      "latent_image": [
        "5",
        0
      ]
    },
    "class_type": "KSampler",
    "_meta": {
      "title": "FicFrame Sampler"
    }
  },
  "4": {
    "inputs": {
      "ckpt_name": "{{model}}"
    },
    "class_type": "CheckpointLoaderSimple",
    "_meta": {
      "title": "SDXL Checkpoint"
    }
  },
  "5": {
    "inputs": {
      "width": "{{width}}",
      "height": "{{height}}",
